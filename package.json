{
    "name": "@navikt/smart-on-fhir",
    "version": "2.0.2",
    "packageManager": "yarn@4.18.1",
    "engines": {
        "node": ">=24"
    },
    "type": "module",
    "scripts": {
        "build": "tsdown",
        "test": "vitest",
        "tsc": "tsc",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "postinstall": "husky",
        "next:major": "yarn version -i major",
        "next:minor": "yarn version -i minor",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs",
        "deps:graph": "yarn dlx madge --exclude '(\\.(test|spec)\\.ts$|__tests__/|/test/)' --extensions ts --ts-config tsconfig.json --image graph.svg src"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://npm.pkg.github.com/"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        "./fhir": {
            "types": "./dist/fhir/index.d.mts",
            "import": "./dist/fhir/index.mjs"
        },
        "./smart": {
            "types": "./dist/smart/index.d.mts",
            "import": "./dist/smart/index.mjs"
        },
        "./zod": {
            "types": "./dist/zod/index.d.mts",
            "import": "./dist/zod/index.mjs"
        },
        "./test": {
            "types": "./dist/test/index.d.mts",
            "import": "./dist/test/index.mjs"
        }
    },
    "dependencies": {
        "@navikt/pino-logger": "^5.0.2",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/core": "^2.12.0",
        "jose": "^6.2.13",
        "openid-client": "^6.8.8",
        "quick-lru": "^7.3.0"
    },
    "peerDependencies": {
        "pino": "9 || 10",
        "zod": "4"
    },
    "devDependencies": {
        "@navikt/tsm-oxfmt": "^0.0.11",
        "@navikt/tsm-oxlint": "^0.0.7",
        "@types/node": "26.6.6",
        "@vitest/coverage-v8": "5.1.0",
        "husky": "^9.1.7",
        "knip": "^6.45.1",
        "lint-staged": "^17.6.0",
        "nock": "15.0.6",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2007",
        "pino": "^10.4.0",
        "pinst": "^3.0.0",
        "tsdown": "0.23.7",
        "typescript": "7.0.2",
        "vite": "^8.3.8",
        "vitepress": "^1.6.4",
        "vitepress-plugin-npm-commands": "^0.10.0",
        "vitepress-plugin-tabs": "^0.9.1",
        "vitest": "^5.1.0",
        "vue": "^3.5.45",
        "zod": "^4.6.7"
    },
    "resolutions": {
        "@opentelemetry/api": "1.9.1"
    }
}
