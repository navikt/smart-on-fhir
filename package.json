{
    "name": "@navikt/smart-on-fhir",
    "version": "1.6.27",
    "packageManager": "yarn@4.18.0",
    "engines": {
        "node": "24"
    },
    "type": "module",
    "scripts": {
        "build": "tsdown",
        "test": "vitest",
        "tsc": "tsc",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "postinstall": "husky",
        "next:major": "yarn version -i major",
        "next:minor": "yarn version -i minor",
        "docs:dev": "vitepress dev docs",
        "docs:build": "vitepress build docs",
        "docs:preview": "vitepress preview docs"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://npm.pkg.github.com/"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        "./client": {
            "types": "./dist/client/index.d.mts",
            "import": "./dist/client/index.mjs"
        },
        "./zod": {
            "types": "./dist/zod/index.d.mts",
            "import": "./dist/zod/index.mjs"
        }
    },
    "dependencies": {
        "@navikt/pino-logger": "^5.0.1",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/core": "^2.11.0",
        "jose": "^6.2.10",
        "openid-client": "^6.8.7",
        "quick-lru": "^7.3.0"
    },
    "peerDependencies": {
        "pino": "9 || 10",
        "zod": "4"
    },
    "devDependencies": {
        "@navikt/tsm-oxfmt": "^0.0.11",
        "@navikt/tsm-oxlint": "^0.0.7",
        "@types/node": "24.13.3",
        "@vitest/coverage-v8": "4.1.11",
        "husky": "^9.1.7",
        "knip": "^6.34.0",
        "lint-staged": "^17.4.1",
        "nock": "^14.0.17",
        "oxfmt": "^0.66.0",
        "oxlint": "^1.81.0",
        "oxlint-tsgolint": "^7.0.2001",
        "pino": "^10.3.1",
        "pinst": "^3.0.0",
        "tsdown": "^0.22.14",
        "typescript": "7.0.2",
        "vitepress": "^1.6.4",
        "vitepress-plugin-npm-commands": "^0.10.0",
        "vitepress-plugin-tabs": "^0.9.1",
        "vitest": "^4.1.11",
        "vue": "^3.5.42",
        "zod": "^4.5.4"
    }
}
