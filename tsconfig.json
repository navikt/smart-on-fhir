{
    "compilerOptions": {
        "rootDir": "./src",
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022"],
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": false,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "dist",
        "verbatimModuleSyntax": true,
        "paths": {
            "#smart/*": ["./src/smart/*"],
            "#fhir/*": ["./src/fhir/*"],
            "#zod": ["./src/zod"],
            "#internal-lib/*": ["./src/internal/lib/*"],
            "#internal-validator/*": ["./src/internal/validator/*"],
            "#test-utils/*": ["./src/__tests__/utils/*"]
        }
    },
    "include": ["src"]
}
